# ==============================================================================
# ECO-RUTA Quibdó - Variables de Entorno para Docker Cloud / Docker Compose / Cluster
# ==============================================================================

# --- ENTORNO GENERAL ---
NODE_ENV=production

# --- BASE DE DATOS POSTGIS (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=eco_ruta_db
POSTGRES_USER=eco_admin
POSTGRES_PASSWORD=eco_secure_password_2026
POSTGRES_PORT=5435

# --- SERVIDOR BACKEND (Fastify + Socket.io + PostGIS Repository) ---
SERVER_PORT=3005
SERVER_HOST=0.0.0.0
# En Docker Cloud / Docker Compose el host del contenedor de base de datos es "postgres"
DATABASE_URL=postgresql://eco_admin:eco_secure_password_2026@postgres:5432/eco_ruta_db
CORS_ORIGIN=*

# --- FRONTEND WEB & REVERSE PROXY NGINX ---
WEB_PORT=80
BACKEND_HOST=server
BACKEND_PORT=3005
VITE_WS_URL=
